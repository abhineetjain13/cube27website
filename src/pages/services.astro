---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { ServicesPage } from "@/components/pages/services/page";
import { SITE_CONFIG } from "@/site-config";
import type { SeoJsonSchema } from "@/components/seo-json";

export const prerender = true;

const provider = {
  "@type": "Organization",
  name: SITE_CONFIG.brand,
  url: SITE_CONFIG.url,
} as const;

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);

const faqItems = (await getCollection("faqs"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    question: entry.data.question,
    answer: entry.data.answer,
  }));

const jsonLd: SeoJsonSchema[] = services.map((service) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.data.name,
  serviceType: service.data.serviceType,
  description: service.data.description,
  provider,
  areaServed: [
    { "@type": "Place", name: "North America" },
    { "@type": "Place", name: "EMEA" },
    { "@type": "Place", name: "APAC" },
    { "@type": "Place", name: "India" },
  ],
  url: `${SITE_CONFIG.url}/services`,
}));
---

<Layout
  title="Services — GCC, AI, Commerce & Salesforce"
  description="Cube27's services across Agentic AI & Automation, Digital Product Engineering, Salesforce & Enterprise Platforms, and GCC-as-a-Service."
  jsonLd={jsonLd}
>
  <ServicesPage client:load faqItems={faqItems} />
</Layout>
