---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "@/components/sections/navbar";
import { Footer } from "@/components/sections/footer";
import { Content as TermsOfService } from "../../files/terms-of-service.md";

export const prerender = true;
---

<Layout
  title="Terms of Service — Cube27"
  description="Cube27's Terms of Service — governing use of and access to CUBE27's services, software, and website."
>
  <div
    class="min-h-screen bg-cube27-background-primary text-cube27-text-primary"
  >
    <Navbar client:load />
    <main class="px-5 py-20 sm:px-8 lg:py-28">
      <article class="prose prose-neutral mx-auto max-w-3xl">
        <p
          class="not-prose typography-eyebrow text-xs uppercase text-cube27-accent-primary"
        >
          Legal
        </p>
        <h1>Terms of Service</h1>
        <TermsOfService />
      </article>
    </main>
    <Footer />
  </div>
</Layout>
