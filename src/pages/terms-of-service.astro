---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "@/components/sections/navbar";
import { Footer } from "@/components/sections/footer";
import { Content as TermsOfService } from "../../files/terms-of-service.md";

export const prerender = true;

const LAST_UPDATED = "22 July 2026";

interface Section {
  id: string;
  label: string;
}

const sections: Section[] = [
  { id: "1-applicability", label: "1. Applicability" },
  { id: "2-cube27", label: "2. CUBE27" },
  {
    id: "3-content-ownership-permissions-and-responsibility",
    label: "3. Content Ownership & Responsibility",
  },
  { id: "4-restrictions", label: "4. Restrictions" },
  { id: "5-violations", label: "5. Violations" },
  {
    id: "6-intellectual-property-rights",
    label: "6. Intellectual Property Rights",
  },
  {
    id: "7-disclaimer-termination-and-account-registration",
    label: "7. Disclaimer & Termination",
  },
  { id: "8-indemnity-and-liability", label: "8. Indemnity & Liability" },
  {
    id: "9-waiver-severability-and-assignment",
    label: "9. Waiver & Assignment",
  },
  { id: "10-arbitration-agreement", label: "10. Arbitration Agreement" },
  { id: "11-governing-law", label: "11. Governing Law" },
  { id: "12-contact", label: "12. Contact" },
];
---

<Layout
  title="Terms of Service — Cube27"
  description="Cube27's Terms of Service — governing use of and access to CUBE27's services, software, and website."
>
  <div
    class="min-h-screen bg-cube27-background-primary text-cube27-text-primary"
  >
    <Navbar client:load />
    <main class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:py-24">
      <header class="max-w-3xl">
        <p
          class="typography-eyebrow text-xs uppercase text-cube27-accent-primary"
        >
          Legal
        </p>
        <h1
          class="typography-heading mt-4 text-balance text-[clamp(2rem,4vw,2.75rem)] font-semibold leading-[1.05] tracking-[-0.025em] text-cube27-text-primary"
        >
          Terms of Service
        </h1>
        <p
          class="mt-5 text-[1.1rem] leading-relaxed text-cube27-text-secondary"
        >
          The terms governing your use of and access to CUBE27&apos;s services,
          software, and website.
        </p>
        <p class="mt-4 text-[0.85rem] text-cube27-text-secondary">
          Last updated: {LAST_UPDATED}
        </p>
      </header>

      <div
        class="mt-12 grid grid-cols-1 gap-x-12 border-t border-cube27-border-primary pt-12 lg:grid-cols-12"
      >
        <aside class="hidden lg:col-span-3 lg:block">
          <nav aria-label="On this page" class="sticky top-24">
            <p
              class="typography-eyebrow text-[0.68rem] uppercase text-cube27-text-secondary"
            >
              On this page
            </p>
            <ul class="mt-4 space-y-2.5 border-l border-cube27-border-primary">
              {
                sections.map((s: Section) => (
                  <li>
                    <a
                      href={`#${s.id}`}
                      class="-ml-px block border-l border-transparent py-0.5 pl-4 text-[0.88rem] text-cube27-text-secondary transition-colors hover:border-cube27-accent-primary hover:text-cube27-text-primary"
                    >
                      {s.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </aside>

        <article class="prose prose-neutral lg:col-span-9">
          <TermsOfService />
        </article>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
