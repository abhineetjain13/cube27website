---
import Layout from "../layouts/Layout.astro";

export const prerender = true;
---

<Layout
  title="Terms of Service — cube27"
  description="Terms governing use of the cube27 website and services."
>
  <main
    class="bg-cube27-background-primary px-5 py-20 text-cube27-text-primary sm:px-8 lg:py-28"
  >
    <article class="prose prose-neutral mx-auto max-w-3xl">
      <p
        class="not-prose typography-eyebrow text-xs uppercase text-cube27-accent-primary"
      >
        Legal
      </p>
      <h1>Terms of Service</h1>
      <p>
        Use of this website and cube27 services is subject to the agreements
        provided with each engagement. The website is provided for general
        information and does not create a client relationship until cube27 and
        the client enter into a written agreement.
      </p>
      <h2>Acceptable use</h2>
      <p>
        You agree not to misuse the website, attempt unauthorised access,
        interfere with its operation, or submit unlawful or harmful content
        through its forms.
      </p>
      <h2>Ownership</h2>
      <p>
        Unless otherwise stated, cube27 owns or licenses the website content,
        branding, and software. You may not reproduce or redistribute it without
        permission.
      </p>
      <h2>Contact</h2>
      <p>
        Questions about these terms can be sent to <a
          href="mailto:contact@cube27.com">contact@cube27.com</a
        >.
      </p>
    </article>
  </main>
</Layout>
