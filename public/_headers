# Content-hashed build output — the filename changes whenever the bytes do,
# so this is the only safe place for `immutable`.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Everything below is served from STABLE, UNHASHED paths
# (images/logos/opt/1.webp, images/office/opt/life-01.webp, cube27-bg.webp,
# icon-192.png). Replacing one of these keeps the same URL, so the response
# must be revalidated rather than served from cache — otherwise a swapped
# logo or photo stays stale in browsers that already have it.
# `no-cache` still caches the file; it just forces a conditional request, and
# the ETag makes the common case a cheap 304.
#
# Rules must not overlap: Cloudflare Pages merges the headers of EVERY
# matching rule and joins duplicate values with a comma, which would emit an
# invalid doubled Cache-Control. Each extension is therefore listed exactly
# once, and there is no broad `/images/*` rule (every file under images/ is
# .webp and is already covered by the extension rule below).
/*.webp
  Cache-Control: public, no-cache

/*.png
  Cache-Control: public, no-cache

/*.jpg
  Cache-Control: public, no-cache

/favicon.svg
  Cache-Control: public, no-cache
